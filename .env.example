# Where the early-access form POSTs JSON ({ name, email, city }).
# Any endpoint that accepts JSON and returns 2xx works (your own API, Formspree, Getform, etc.).
# Leave empty and the form will clearly say that submissions are not connected yet.
VITE_FORM_ENDPOINT=

# Public URL of the deployed site, used for canonical and Open Graph tags (no trailing slash).
VITE_SITE_URL=
