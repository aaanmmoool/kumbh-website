{
  "name": "kumbh-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Tirtha — a premium, Kumbh-inspired product website (placeholder brand).",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "assets": "node scripts/generate-assets.mjs",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lighthouse": "node scripts/lighthouse.mjs",
    "og-image": "node scripts/og-image.mjs",
    "build:artifact": "tsc --noEmit && vite build --base ./ && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs && node scripts/package-artifact.mjs",
    "photos": "node scripts/photos.mjs"
  },
  "dependencies": {
    "@fontsource-variable/eczar": "^5.3.0",
    "@fontsource/mukta": "^5.3.0",
    "@react-three/fiber": "^9.8.1",
    "lucide-react": "^1.55.0",
    "motion": "^14.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "lighthouse": "^13.5.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
